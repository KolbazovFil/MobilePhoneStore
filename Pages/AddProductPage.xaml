<Page x:Class="MobilePhoneStore.Pages.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MobilePhoneStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Добавления-Редактирование">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название товара" Grid.Row="0" Grid.Column="0" Style="{StaticResource CustomTextBlock}"/>
        <TextBlock Text="Цена товара" Grid.Row="1" Grid.Column="0" Style="{StaticResource CustomTextBlock}"/>
        <TextBlock Text="Категория товара" Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomTextBlock}"/>
        <TextBlock Text="Загрузить фотографию" Grid.Row="3" Grid.Column="0" Style="{StaticResource CustomTextBlock}"/>


        <TextBox Name="ProductNameTextBox" Style="{StaticResource CustomTextBox}" Text="{Binding ProductName}" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="1"/>
        <TextBox Name="PriceTextBox" Style="{StaticResource CustomTextBox}" Text="{Binding Price}" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="1"/>
        <ComboBox Name="CategoriesComboBox" DisplayMemberPath="CategoryName" SelectedItem="{Binding Categories}" Style="{StaticResource CustomAddComboBox}" Grid.Row="2" Grid.Column="1"/>
        <TextBox Name="PhotoTextBox" Style="{StaticResource CustomTextBox}" Text="{Binding Image}" VerticalContentAlignment="Center" Grid.Row="3" Grid.Column="1"/>


        <Button Name="SaveButton" Grid.Row="6" Content="Сохранить" Click="SaveButton_Click" Style="{StaticResource CustomButtonStyle}" />
        <Button Name="CancelButton" Grid.Row="6" Grid.Column="1" Content="Отменить" Click="CancelButton_Click" Style="{StaticResource CustomButtonStyle}" />
    </Grid>
</Page>
