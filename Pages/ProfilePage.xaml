<Page x:Class="MobilePhoneStore.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MobilePhoneStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Профиль">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Профиль" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CustomTextBlock}" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Text="ФИО" Grid.Row="1" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Логин" Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Адрес электронной почты" Grid.Row="3" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Номер телефона" Grid.Row="4" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>

        <TextBox Name="FIOTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource CustomTextBox}" Text="{Binding FullName}" IsReadOnly="True"/>
        <TextBox Name="LoginTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CustomTextBox}" Text="{Binding Login}" IsReadOnly="True"/>
        <TextBox Name="EmailTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource CustomTextBox}" Text="{Binding Email}" IsReadOnly="True"/>
        <TextBox Name="PhoneNumberTextBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource CustomTextBox}" Text="{Binding Phone}" IsReadOnly="True"/>

        <Button Name="CancelButton" Content="Назад" ToolTip="Нашмите чтобы вернуться обратно" Grid.Row="7" Grid.Column="1" Style="{StaticResource CustomButtonStyle}" HorizontalAlignment="Left" Margin="10,0" Click="CancelButton_Click"/>
        <Button Name="EditButton" Content="Редактировать" ToolTip="Нашмите для редактирования профиля" Grid.Row="7" Grid.Column="0" Style="{StaticResource CustomButtonStyle}" HorizontalAlignment="Right" Margin="10,0" Click="EditButton_Click" Visibility="Visible"/>
        <Button Name="SaveButton" Content="Сохранить" ToolTip="Нажмите для сохранения изменений в профиле" Grid.Row="7" Grid.Column="0" Style="{StaticResource CustomButtonStyle}" Background="Green" HorizontalAlignment="Right" Margin="10,0" Click="SaveButton_Click" Visibility="Collapsed"/>

        <TextBlock Name="Exit" Text="Выйти из профиля" ToolTip="Нажмите для выхода из профиля" Style="{StaticResource CustomTextBlock}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Foreground="IndianRed" Cursor="Hand" MouseLeftButtonDown="Exit_MouseLeftButtonDown"/>
    </Grid>
</Page>
