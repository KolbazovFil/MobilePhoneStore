<Page x:Class="MobilePhoneStore.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MobilePhoneStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Регистрация" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CustomTextBlock}" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Text="ФИО" Grid.Row="1" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Логин" Grid.Row="2" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Пароль" Grid.Row="3" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Подтверждение пароля" Grid.Row="4" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Адрес электронной почты" Grid.Row="5" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>
        <TextBlock Text="Номер телефона" Grid.Row="6" Grid.Column="0" Style="{StaticResource CustomTextBlock}" Width="300" HorizontalAlignment="Right"/>

        <TextBox Name="FIOTextBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource CustomTextBox}"/>
        <TextBox Name="LoginTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CustomTextBox}"/>
        <PasswordBox Name="PasswordBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource CustomPasswordBox}"/>
        <PasswordBox Name="ConfirmPasswordBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource CustomPasswordBox}"/>
        <TextBox Name="EmailTextBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource CustomTextBox}"/>
        <TextBox Name="PhoneNomberTextBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource CustomTextBox}"/>

        <Button Name="CancelButton" Content="Отмена" Grid.Row="7" Grid.Column="1" Style="{StaticResource CustomButtonStyle}" HorizontalAlignment="Left" Margin="10,0" Click="CancelButton_Click"/>
        <Button Name="RegistrationButton" Content="Регистрация" Grid.Row="7" Grid.Column="0" Style="{StaticResource CustomButtonStyle}" HorizontalAlignment="Right" Margin="10,0" Click="RegistrationButton_Click"/>

    </Grid>
</Page>
