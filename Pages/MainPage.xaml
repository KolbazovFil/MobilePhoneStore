<Page x:Class="MobilePhoneStore.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MobilePhoneStore.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главная" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="410*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CustomMenu}">
            
            <MenuItem Header="Продукция" Name="Products" Style="{StaticResource CustomMenuItem}" Height="40">

                <MenuItem Header="Вся продукция" Name="AllProducts" Style="{StaticResource CustomMenuItem}" Click="ProductAll_Click">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/icons8-йода-67.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Apple" Name="Apple" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="Apple">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/Apple.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Samsung" Name="Samsung" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="Samsung">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/samsung_logo.ico"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Xiaomi" Name="Xiaomi" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="Xiaomi">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/xiaomi_logo.ico"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Sony" Name="Sony" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="Sony">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/sony_logo.ico"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Asus" Name="Asus" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="Asus">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/asus_logo.ico"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="HP" Name="HP" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="HP">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/hp_logo.ico"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Honor" Name="Honor" Style="{StaticResource CustomMenuItem}" Click="ProductFilter_Click" Tag="Honor">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/honor_logo.ico"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Категории" Name="Categories" Style="{StaticResource CustomMenuItem}" Height="40">

                <MenuItem Header="Все категории" Name="AllCategories" Style="{StaticResource CustomMenuItem}" Click="ProductAll_Click">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/icons8-йода-67.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Мобильные телефоны" Name="Mobile" Style="{StaticResource CustomMenuItem}" Click="CategoryFilter_Click" Tag="Мобильные телефоны">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/phone.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Планшеты" Name="Tablet" Style="{StaticResource CustomMenuItem}" Click="CategoryFilter_Click" Tag="Планшеты">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/tablet.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Цифровые плееры" Name="Player" Style="{StaticResource CustomMenuItem}" Click="CategoryFilter_Click" Tag="Цифровые плееры">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/playeer.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Ноутбуки" Name="Notebook" Style="{StaticResource CustomMenuItem}" Click="CategoryFilter_Click" Tag="Ноутбуки">
                    <MenuItem.Icon>
                        <Image Source="/Resurces/notebook.ico"></Image>
                    </MenuItem.Icon>
                </MenuItem>

            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="Войти" ToolTip="Нажмите чтобы перейти на страницу авторизации" Name="Authorization" Width="80" Height="40" Visibility="Visible" Style="{StaticResource CustomButtonStyle}" Click="Authorization_Click"/>

            <StackPanel Name="ProfilePanel" Orientation="Horizontal" Visibility="Collapsed">
                <Button Name="ProfileButton" Width="130" Height="40" Style="{StaticResource CustomButtonStyle}" Click="ProfileButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resurces/user_profile.ico" Height="25" Width="25"/>
                        <TextBlock Text="Профиль" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock Text="Фильтры" Style="{StaticResource CustomTextBlock}" HorizontalAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="Минимальная цена" Style="{StaticResource CustomTextBlock}" />
            <TextBox Name="MinPriceTextBox" ToolTip="Введите минимальную цену для фильтрации в формате 4000,00" Style="{StaticResource CustomTextBox}" Width="200" Height="30"/>
            <TextBlock Text="Максимальная цена" Style="{StaticResource CustomTextBlock}"/>
            <TextBox Name="MaxPriceTextBox" ToolTip="Введите максимальную цену для фильтрации в формате 4000,00" Style="{StaticResource CustomTextBox}" Width="200" Height="30"/>
            <Button Content="Применить фильтр" ToolTip="Нажмите для применения фильтрации" Style="{StaticResource CustomButtonStyle}" Width="190" Margin="0,10" Click="ApplyPriceFilterButton_Click"/>
        </StackPanel>

        <ListView Name="ListProducts" Grid.Row="1" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="450"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ProductName}" Style="{StaticResource CustomTextBlock}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left"/>

                        <TextBlock Text="Цена: " Style="{StaticResource CustomTextBlock}" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"/>

                        <TextBlock Text="{Binding Price}" Style="{StaticResource CustomTextBlock}" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"/>

                        <TextBlock Text=" руб." Style="{StaticResource CustomTextBlock}" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left"/>

                        <Image Width="450" Grid.Row="1" Stretch="UniformToFill" HorizontalAlignment="Center" Grid.ColumnSpan="4">
                            <Image.Source>
                                <Binding Path="Image">
                                    <Binding.TargetNullValue>
                                        <ImageSource>/Resurces/plug.png</ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
    </Grid>
</Page>
